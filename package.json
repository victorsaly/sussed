{
  "name": "sussed",
  "private": true,
  "version": "0.1.0",
  "description": "SUSSED \u2014 a studio of small, quiet daily puzzle games.",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @sussed/bridges dev",
    "build": "pnpm -r --filter './games/*' build",
    "typecheck": "tsc -b --pretty",
    "generate": "pnpm -r --filter './games/*' generate",
    "verify": "tsx tools/verify.ts",
    "service:dev": "pnpm --filter @sussed/players dev",
    "test": "tsx tools/levels.test.ts && tsx tools/hints.test.ts",
    "dev:twostars": "pnpm --filter @sussed/twostars dev",
    "dev:loop": "pnpm --filter @sussed/loop dev",
    "dev:arrows": "pnpm --filter @sussed/arrows dev",
    "site": "tsx tools/build-site.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
